{
  "type": "object",
  "properties": {
    "ir_version": {
      "const": "0.1"
    },
    "capability_profile": {
      "const": "mechanical-v0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "port": {
                "const": "shaft"
              }
            },
            "required": [
              "node",
              "port"
            ],
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "port": {
                "const": "shaft"
              }
            },
            "required": [
              "node",
              "port"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ir_version",
    "capability_profile",
    "name",
    "description",
    "nodes",
    "links"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wf:blueprint:0.1",
  "title": "WF-IR 0.1 Blueprint",
  "$comment": "Schema is only the structural gate. Strict lexical JSON parsing and catalog-dependent semantic validation are also mandatory. No external references.",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "true"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "false"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "inventory_at_least"
            },
            "item": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "op",
            "item",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "harvest": {
      "type": "object",
      "properties": {
        "source_kind": {
          "const": "river"
        },
        "max_withdraw_eu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "efficiency": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_kind",
        "max_withdraw_eu",
        "efficiency"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "work_eu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "rate_eu_per_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "enabled_when": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "inputs",
        "outputs",
        "work_eu",
        "rate_eu_per_tick",
        "enabled_when"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -31,
            "maximum": 31
          },
          "minItems": 2,
          "maxItems": 2
        },
        "ports": {
          "type": "array",
          "items": {
            "const": "shaft"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "inventory_capacities": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "harvest": {
          "$ref": "#/$defs/harvest"
        },
        "process": {
          "$ref": "#/$defs/process"
        },
        "visual": {
          "type": "object",
          "properties": {
            "shape": {
              "enum": [
                "wheel",
                "mill",
                "block",
                "shaft"
              ]
            }
          },
          "required": [
            "shape"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "offset",
        "ports",
        "inventory_capacities",
        "visual"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "harvest",
          "process"
        ]
      }
    }
  }
}
